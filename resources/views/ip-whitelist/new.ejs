<!DOCTYPE html>
<html lang="ko">
<%- include('../partials/_head.ejs', { 
  title: 'IP 주소 등록',
  description: '관리자 페이지에 접근할 수 있는 IP 화이트리스트 설정',
}) %>
<body>
  <div class="flex h-screen">
    <%- include('../partials/_sidebar.ejs', { activePage: 'whitelist' }) %>
    <main class="w-full h-full overflow-y-auto p-10 page-animation-enter" >
      <div style="min-width: 800px; max-width: 800px;">
        <div class="flex items-center mb-6">
          <a href="/admin/whitelist" class="mr-4">
            <svg class="w-6 h-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
          </a>
          <h1 class="text-3xl font-bold text-gray-800">
            IP 주소 등록
          </h1>
        </div>

        <% if (locals.error) { %>
          <div class="mb-6 p-4 bg-red-100 text-red-700 rounded-md">
            <div class="flex items-center text-sm">
              <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <%= error %>
            </div>
          </div>
        <% } %>

        <form action="/admin/whitelist" method="POST">
          <div class="mb-6">
            <label for="ip" class="block text-sm font-medium text-gray-700 mb-1">IP 주소</label>
            <input 
              type="text" 
              id="ip" 
              name="ip" 
              value="<%= locals.ipData ? ipData.ip : '' %>"
              class="border border-gray-300 rounded-lg p-4 w-full"
              placeholder="예: 192.168.1.1"
              required
            >
            <p class="mt-1 text-xs text-gray-500">IPv4 형식의 주소를 입력하세요. (예: 192.168.1.1)</p>
          </div>
          
          <div class="mb-6">
            <label for="description" class="block text-sm font-medium text-gray-700 mb-1">설명 (선택사항)</label>
            <input 
              type="text" 
              id="description" 
              name="description" 
              value="<%= locals.ipData ? ipData.description : '' %>"
              class="border border-gray-300 rounded-lg p-4 w-full"
              placeholder="예: 개발 서버, 운영 서버 등"
            >
          </div>
          
          <div class="flex items-center justify-end">
            <button 
              type="submit" 
              class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-lg w-24"
            >
              등록
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>
</body>
</html>