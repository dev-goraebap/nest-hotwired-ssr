<!DOCTYPE html>
<html lang="ko">
<%- include('../partials/_head.ejs', { 
  title: '관리자 페이지 접근 관리',
  description: '관리자 페이지에 접근할 수 있는 IP 화이트리스트 설정',
}) %>
<body>
  <div class="flex h-screen">
    <%- include('../partials/_sidebar.ejs', { activePage: 'whitelist' }) %>
    <main class="w-full h-full overflow-y-auto p-10 page-animation-enter" >
      <div style="min-width: 1000px; max-width: 1000px;">
        <div class="flex justify-between items-center mb-6">
          <h1 class="text-3xl font-bold text-gray-800">
            접근 관리
          </h1>
          <a href="/admin/whitelist/new" class="flex items-center justify-center gap-2 p-3 bg-blue-900 text-white rounded-xl" style="width: 170px;">
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            <span class="text-sm">
              IP 주소 등록
            </span>
          </a>
        </div>

        <!-- 설명 메시지 -->
        <div class="mb-6 p-4 bg-blue-100 text-blue-700 rounded-md">
          <div class="flex items-center text-sm">
            <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            관리자 페이지, 스웨거 문서에 접근할 수 있는 IP 화이트리스트를 설정합니다.
          </div>
        </div>
        
        <!-- 결과 메시지가 있으면 표시 -->
        <% if (locals.result && result.messages && result.messages.length > 0) { %>
          <div class="mb-6 p-4 <%= result.success ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %> rounded-md">
            <div class="flex items-center text-sm">
              <% if (result.success) { %>
                <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              <% } else { %>
                <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              <% } %>
              <%= result.firstMessage %>
            </div>
          </div>
        <% } %>

        <!-- IP 리스트 테이블 -->
        <div class="overflow-x-auto bg-white rounded-lg border border-gray-300">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  IP 주소
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  설명
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  등록일자
                </th>
                <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                  관리
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% if (ipList && ipList.length > 0) { %>
                <% ipList.forEach(ip => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-gray-900"><%= ip.ip %></div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="text-sm text-gray-900"><%= ip.description || '-' %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-500">
                        <%= new Date(ip.createdAt).toLocaleDateString('ko-KR', { 
                          year: 'numeric', 
                          month: 'long', 
                          day: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit'
                        }) %>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">
                      <form
                        action="/admin/whitelist/delete/<%= encodeURIComponent(ip.ip) %>"
                        method="POST"
                        onsubmit="return confirm('정말 이 IP 주소를 삭제하시겠습니까?');"
                      >
                        <button type="submit" class="text-red-500 hover:text-red-700 text-sm">
                          삭제
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                    등록된 IP 주소가 없습니다.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</body>
</html>