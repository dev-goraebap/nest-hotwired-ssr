@let(adminMode = admin ?? false)

<nav
  class="flex h-full border-r border-base-300 sticky top-0 overflow-y-auto bg-gradient-to-b from-base-200 to-base-300">
  <div class="prose prose-sm p-10">
    <h1 class="font-extrabold">NestJs Is Coming</h1>
    <a href="/" class="{{ isActiveLink('/', true) && 'text-blue-500' }}">Home</a>

    @if(adminMode)
      <h3 class="font-bold">관리</h3>
      <ul>
        <li>
          <a href="/admin/documents" class="{{ isActiveLink('/admin/documents', true) && 'text-blue-500' }}">문서 관리</a>
        </li>
        <li>
          <a href="/admin/categories" class="{{ isActiveLink('/admin/categories', true) && 'text-blue-500' }}">카테고리 관리</a>
        </li>
      </ul>
    @else
      @each(category in categories)
        <h3 class="font-bold">{{category.name}}</h3>
        <ul>
          @if(!category?.documents?.length)
            <li>
              <a href="#">문서 없음</a>
            </li>
          @end

          @each(document in category?.documents)
            <li>
              <a href="{{document.getUrl()}}" class="{{ isActiveLink(document.getUrl()) && 'text-blue-500' }}">
                {{document.title}}
              </a>
            </li>
          @end
        </ul>
      @end
    @end
  </div>
</nav>