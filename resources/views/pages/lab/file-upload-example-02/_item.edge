<div class="border rounded-lg p-4 bg-gray-50">
  <div class="flex items-center justify-between">
    <div class="flex-1">
      <p class="font-medium">{{ item.blob.filename }}</p>
      <p class="text-sm text-gray-600">
        크기: {{ item.blob.getHumanFileSize() }} |
        타입: {{ item.blob.contentType }} |
        업로드: {{ item.createdAt.toLocaleDateString() }}
      </p>
      <p class="text-xs text-gray-500 mt-1">
        키: {{ item.blob.key }} |
        체크섬: {{ item.blob.checksum.substring(0, 8) }}... |
        서비스: {{ item.blob.serviceName }}
      </p>
      @if(Object.keys(item.blob.metadata).length > 0)
      <div class="mt-2">
        <p class="text-xs font-medium text-gray-600">메타데이터:</p>
        <div class="text-xs text-gray-500 bg-gray-100 p-2 rounded mt-1">
          @each((value, key) in item.blob.metadata)
          <div><strong>{{ key }}:</strong> {{ typeof value === 'object' ? JSON.stringify(value) : value }}</div>
          @end
        </div>
      </div>
      @end
    </div>
    <div class="flex gap-2">
      @if(item.blob.isImage())
      <span class="badge badge-success">이미지</span>
      @elseif(item.blob.isVideo())
      <span class="badge badge-info">비디오</span>
      @elseif(item.blob.isAudio())
      <span class="badge badge-warning">오디오</span>
      @else
      <span class="badge badge-neutral">문서</span>
      @end
    </div>
  </div>
</div>