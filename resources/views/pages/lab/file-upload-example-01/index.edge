@layout.app()
  @slot('main')
    @!uikit.backButton()

    {{ markdownHtml }}

    @!component('pages/lab/file-upload-example-01/_form')

    @if(attachments && attachments.length > 0)
      <div class="mt-8 max-w-xl">
        <h3 class="font-semibold mb-4">업로드된 파일 목록 ({{ attachments.length }}개)</h3>
        <div class="grid gap-4">
          @each(item in attachments)
            @!component('pages/lab/file-upload-example-01/_item', { item })
          @end
        </div>
      </div>
    @else
      <div class="mt-8 text-center text-gray-500">
        <p>아직 업로드된 파일이 없습니다.</p>
      </div>
    @end
  @end
@end