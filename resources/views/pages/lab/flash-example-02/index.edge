@layout.app()
  @slot('main')
    {{{ document?.content }}}

    {{-- 플래시 메시지 표시 --}}
    @if(flash?.type === 'notice')
      <div 
        data-controller="flash-02" 
        class="flex justify-between alert alert-success mb-4">
        {{ flash.message }}
        <button data-action="flash-02#onClose" class="btn btn-soft btn-sm btn-primary">닫기</button>
      </div>
    @elseif(flash?.type === 'alert')
      <div 
        data-controller="flash-02" 
        data-flash-02-time-value="1000"
        class="flex justify-between alert alert-error mb-4">
        {{ flash.message }}
        <button data-action="flash-02#onClose" class="btn btn-soft btn-sm btn-error">닫기</button>
      </div>
    @end

    <div class="flex gap-4">
      <a href="/lab/flash-example-02/success" data-turbo-method="post" class="btn btn-soft btn-primary">
        성공적인 작업 요청
      </a>
      <a href="/lab/flash-example-02/failure" data-turbo-method="post" class="btn btn-soft btn-secondary">
        작업 실패 요청
      </a>
    </div>
  @end
@end