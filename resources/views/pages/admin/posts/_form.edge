@let(action = editMode ? `/admin/posts/${post?.id}` : '/admin/posts')
@let(method = editMode ? 'PUT' : 'POST')
@let(submitText = editMode ? '수정' : '등록')

<form action="{{action}}" method="{{method}}" data-controller="modal document-form" class="h-full w-5xl">
  <input type="text" class="hidden" name="post[id]" value="{{ document?.id ?? '' }}">

  <div class="flex w-full h-full">
    <div class="grow flex flex-col gap-4 h-full border-x border-base-300 bg-base-100">
      <input name="post[title]" class="hidden" value="{{document?.title ?? ''}}" />

      <!-- 텍스트 에디터 -->
      <div class="w-[700px] h-full">
        <div data-controller="tiny-mce" id="tinyMceEditor" class="grow h-full">
          {{{document?.content ?? ''}}}
        </div>
      </div>
      <!-- 텍스트 에디터 데이터 바인딩 -->
      <textarea name="post[content]" id="content_hidden" class="hidden">
        {{{document?.content ?? ''}}}
      </textarea>
    </div>

    <div class="flex flex-col justify-between gap-4 h-full w-sm max-w-sm p-4">
      <div class="flex flex-col gap-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend text-sm">카테고리</legend>
          <button type="button" data-url="/admin/categories/modal" data-action="modal#onOpen" class="btn btn-soft btn-primary">
            카테고리 선택
          </button>
        </fieldset>

        <template data-document-form-target="categoryIdTemplate">
          <input type="text" name="post[category][id]" class="hidden">
          <!-- 플레시 저장용 -->
          <input type="text" name="post[category][name]" class="hidden">
          <div class="badge badge-accent"></div>
        </template>
        <div data-document-form-target="categoryContainer">
          @if(document?.category?.id)
          <input type="text" name="post[category][id]" class="hidden" value="{{document?.category?.id}}">

          <!-- 플레시 저장용 -->
          <input type="text" name="post[category][name]" class="hidden" value="{{document?.category?.name}}">
          <div class="badge badge-accent">{{document?.category?.name}}</div>
          @end
        </div>

        <fieldset class="fieldset">
          <legend class="fieldset-legend text-sm">슬러그</legend>
          <label class="input w-full">
            /
            <input type="text" name="post[slug]" class="w-full" placeholder="고유한 slug(url)을 만들어주세요"
            value="{{{document?.slug ?? ''}}}" />
          </label>
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend text-sm">태그</legend>
          <div data-controller="tag-input" 
               data-tag-input-search-url-value="/admin/tags/search"
               class="w-full">
            
            <!-- 선택된 태그들 -->
            <div data-tag-input-target="tagContainer" class="mb-2"></div>
            
            <!-- 입력 필드 -->
            <label class="input w-full">
              <input data-tag-input-target="input" 
                     data-action="input->tag-input#search keydown->tag-input#handleKeydown"
                     type="text" 
                     class="w-full" 
                     placeholder="태그를 입력하세요 (Enter로 생성)"
                     autocomplete="off" />
            </label>
            
            <!-- Turbo Frame (검색 결과) -->
            <div class="relative">
              <turbo-frame id="tagSearchFrame" 
                           data-tag-input-target="frame"
                           class="absolute top-1 left-0 w-full bg-white border border-gray-200 rounded shadow-lg z-10 max-h-48 overflow-y-auto">
                <!-- 서버에서 렌더링된 검색 결과가 여기에 삽입됨 -->
              </turbo-frame>
            </div>
            
            <!-- 폼 전송용 숨겨진 입력 -->
            <input type="hidden" 
                   name="post[tagIds]" 
                   data-tag-input-target="hiddenInput" 
                   value="[]">
          </div>
        </fieldset>

      </div>

      <div class="flex justify-between gap-4">
        <a href="/admin/documents" data-turbo-method="get" data-turbo-confirm="작업 내용이 초기화됩니다. 취소하시겠어요?"
          class="flex-1/2 btn btn-soft btn-warning">작업 취소</a>
        <button class="flex-1/2 btn btn-soft btn-success">{{ submitText }}</button>
      </div>
    </div>
  </div>

  @!uikit.modal()
</form>