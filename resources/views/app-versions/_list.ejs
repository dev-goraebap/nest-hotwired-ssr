<div class="overflow-x-auto bg-white rounded-lg border border-gray-300">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
          순번
        </th>
        <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
          플랫폼
        </th>
        <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
          버전
        </th>
        <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
          강제 업데이트
        </th>
        <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
          생성일
        </th>
        <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
          삭제
        </th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% if (versions && versions.length > 0) { %>
        <% versions.forEach((version, index) => { %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">
              <%= index + 1 %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-center">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                <%= version.type === 'IOS' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
                <%= version.type %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-center">
              <%= version.version %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
              <!-- 강제업데이트 활성화/비활성화 토글 -->
              <form 
                id="form-<%= version.type %>-<%= version.version %>"
                class="inline-block"
                action="/admin/versions/update/<%= version.type %>/<%= version.version %>/valid-yn" 
                method="POST"
              >
                <input type="hidden" name="validYn" value="<%= version.validYn === 'Y' ? 'N' : 'Y' %>">

                <div class="inline-flex items-center">
                  <input 
                    type="checkbox" 
                    id="checkbox-<%= version.type %>-<%= version.version %>"
                    class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500 cursor-pointer"
                    <%= version.validYn === 'Y' ? 'checked' : '' %>
                    onclick="toggleValidYn(event, '<%= version.type %>', '<%= version.version %>', '<%= version.validYn %>')"
                  >
                  <label 
                    for="checkbox-<%= version.type %>-<%= version.version %>"
                    class="ml-2 text-sm font-medium text-gray-700 cursor-pointer"
                  >
                    <%= version.validYn === 'Y' ? '활성화됨' : '비활성화' %>
                  </label>
                </div>
              </form>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">
              <%= version.createdAt.toLocaleDateString() %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-center">
              <!-- 삭제 버튼 -->
              <form
                id="delete-form-<%= version.type %>-<%= version.version %>"
                class="inline-block"
                action="/admin/versions/delete/<%= version.type %>/<%= version.version %>"
                method="POST"
              >
                <button 
                  type="button" 
                  class="text-red-500 hover:text-red-700 text-sm"
                  onclick="confirmDelete('<%= version.type %>', '<%= version.version %>')"
                >
                  삭제
                </button>
              </form>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="6" class="px-6 py-8 text-center text-gray-500">
            등록된 앱 버전이 없습니다.
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<script>
  // 강제 업데이트 토글 처리 함수
  function toggleValidYn(event, type, version, currentStatus) {
    // 체크박스의 상태 변경 취소 (UI는 서버 응답 후 업데이트)
    event.preventDefault();
    
    const isCurrentlyActive = currentStatus === 'Y';
    const actionText = isCurrentlyActive ? '해제' : '활성화';
    
    if (confirm(`이 버전의 강제 업데이트를 ${actionText}하시겠습니까?`)) {
      document.getElementById(`form-${type}-${version}`).requestSubmit();
    }
  }
  
  // 삭제 확인 처리 함수
  function confirmDelete(type, version) {
    if (confirm('이 앱 버전을 삭제하시겠습니까? 이 작업은 취소할 수 없습니다.')) {
      document.getElementById(`delete-form-${type}-${version}`).requestSubmit();
    }
  }
</script>