<!DOCTYPE html>
<html lang="ko">
<%- include('../partials/_head.ejs', { 
  title: '앱 버전 등록',
  description: '새로운 앱 버전을 등록합니다.',
}) %>
<body>
  <div class="flex h-screen">
    <%- include('../partials/_sidebar.ejs', { activePage: 'versions' }) %>
    <main class="w-full h-full p-10 page-animation-enter" style="min-width: 800px; max-width: 800px;">
      <div class="max-w-2xl">
        <div class="flex items-center mb-6">
          <a href="/admin/versions" class="mr-3 text-gray-500 hover:text-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
          </a>
          <h1 class="text-2xl font-bold text-gray-800">앱 버전 등록</h1>
        </div>

        <% if (locals.error) { %>
          <div class="mb-6 p-4 bg-red-100 text-red-700 rounded-md">
            <div class="flex items-center">
              <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <%= error %>
            </div>
          </div>
        <% } %>

        <form method="POST" action="/admin/versions" class="">
          <div class="mb-6">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="type">
              플랫폼 타입
            </label>
            <select 
              id="type" 
              name="type" 
              required
              class="border border-gray-300 rounded-lg p-4 w-full"
            >
              <option value="" disabled selected>플랫폼을 선택하세요</option>
              <% platformTypes.forEach(type => { %>
                <option value="<%= type %>" <%= (locals.formData && formData.type === type) ? 'selected' : '' %>>
                  <%= type %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="mb-6">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="version">
              버전
            </label>
            <input 
              type="text" 
              id="version" 
              name="version" 
              required
              pattern="^[0-9.]+$"
              title="버전은 숫자와 마침표(.)만 사용할 수 있습니다"
              placeholder="예: 76"
              value="<%= locals.formData ? formData.version : '' %>"
              class="border border-gray-300 rounded-lg p-4 w-full"
            >
            <p class="mt-1 text-xs text-gray-500">숫자와 마침표(.)만 입력 가능합니다.</p>
          </div>

          <div class="flex items-center justify-end">
            <button 
              type="submit" 
              class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-lg w-24"
            >
              등록
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>
</body>
</html>