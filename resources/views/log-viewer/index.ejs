<!DOCTYPE html>
<html lang="ko">
<%- include('../partials/_head.ejs', { 
  title: '로그 조회',
  description: '시스템 로그를 날짜와 키워드로 검색할 수 있습니다',
}) %>
<body>
  <div class="flex h-screen">
    <!-- 사이드바 -->
    <%- include('../partials/_sidebar.ejs', { activePage: 'logs' }) %>

    <!-- 메인컨텐츠 -->
    <main class="w-full h-full overflow-y-auto p-10 page-animation-enter" >
      <div style="min-width: 1000px; max-width: 1000px;">
        <div class="flex justify-between items-center mb-6">
          <h1 class="text-3xl font-bold text-gray-800">
            시스템 로그 조회
          </h1>
        </div>

        <!-- 설명 메시지 -->
        <div class="mb-6 p-4 bg-blue-100 text-blue-700 rounded-md">
          <div class="flex items-center text-sm">
            <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            특정 날짜의 로그를 키워드로 검색할 수 있습니다. 검색어는 최소 2글자 이상 입력해주세요.
          </div>
        </div>

        <!-- 검색 폼 -->
        <div class="mb-8">
          <form 
            action="/admin/logs" 
            method="GET" 
            data-turbo-frame="_top"
            class="flex flex-wrap gap-4 items-end"
          >
            <div class="min-w-[200px]">
              <label for="date" class="block text-sm font-medium text-gray-700 mb-1">날짜</label>
              <input 
                type="date" 
                id="date" 
                name="date" 
                value="<%= locals.searchDate || '' %>" 
                class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                required
              >
            </div>
            
            <div class="min-w-[200px] flex-grow">
              <label for="keyword" class="block text-sm font-medium text-gray-700 mb-1">검색어 (2글자 이상)</label>
              <input 
                type="text" 
                id="keyword" 
                name="keyword" 
                value="<%= locals.searchParams ? searchParams.keyword : '' %>" 
                class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                placeholder="검색어를 입력하세요"
                required
                minlength="2"
              >
            </div>
            
            <div class="min-w-[150px]">
              <label for="logLevel" class="block text-sm font-medium text-gray-700 mb-1">로그 타입</label>
              <select 
                id="logLevel" 
                name="logLevel" 
                class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
              >
                <option value="all" <%= locals.searchParams && searchParams.logLevel === 'all' ? 'selected' : '' %>>전체</option>
                <option value="INFO" <%= locals.searchParams && searchParams.logLevel === 'INFO' ? 'selected' : '' %>>INFO</option>
                <option value="ERROR" <%= locals.searchParams && searchParams.logLevel === 'ERROR' ? 'selected' : '' %>>ERROR</option>
                <option value="WARN" <%= locals.searchParams && searchParams.logLevel === 'WARN' ? 'selected' : '' %>>WARN</option>
                <option value="DEBUG" <%= locals.searchParams && searchParams.logLevel === 'DEBUG' ? 'selected' : '' %>>DEBUG</option>
              </select>
            </div>
            
            <div>
              <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md">
                검색
              </button>
            </div>
          </form>
        </div>

        <!-- 검색 결과 메시지 -->
        <% if (locals.result) { %>
          <div class="mb-6">
            <% if (result.success) { %>
              <div class="p-4 bg-green-100 text-green-700 rounded-md">
                <%= result.firstMessage %>
              </div>
            <% } else { %>
              <div class="p-4 bg-red-100 text-red-700 rounded-md">
                <%= result.firstMessage %>
              </div>
            <% } %>
          </div>
        <% } %>

        <!-- 검색 결과 목록 -->
        <% if (locals.result && result.success && result.data && result.data.length > 0) { %>
          <div class="space-y-6 mb-10">
            <% result.data.forEach(entry => { %>
              <!-- 로그 레벨에 따른 스타일 적용 -->
              <div class="<%= helpers.getLogLevelStyle(entry.level).borderClass %> border-l-4 rounded-md overflow-hidden shadow-sm">
                <div class="p-2 <%= helpers.getLogLevelStyle(entry.level).bgClass %> flex items-center justify-between">
                  <div class="font-mono text-sm">
                    <%= entry.timestamp %> [<%= entry.level %>]
                  </div>
                  
                  <!-- 로그 접기/펼치기 토글 버튼 -->
                  <button 
                    class="text-xs <%= helpers.getLogLevelStyle(entry.level).textClass %> hover:underline" 
                    onclick="toggleLogContent(this)"
                    data-expanded="true"
                  >
                    접기
                  </button>
                </div>
                <div class="log-content p-4 bg-white">
                  <pre class="whitespace-pre-wrap font-mono text-sm overflow-x-auto"><%= entry.content %></pre>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else if (locals.result) { %>
          <!-- 검색 결과가 없는 경우 Empty 상태 표시 -->
          <div class="border-2 border-dashed border-gray-300 rounded-md p-10 flex flex-col items-center justify-center bg-gray-50">
            <svg class="w-16 h-16 text-gray-400 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="text-gray-500 text-lg font-medium">검색 결과가 없습니다.</p>
            <p class="text-gray-400 mt-1">다른 키워드나 날짜로 다시 검색해보세요.</p>
          </div>
        <% } %>
      </div>
    </main>
  </div>
  
  <script>
    // 로그 접기/펼치기 함수
    function toggleLogContent(button) {
      const logContentDiv = button.parentElement.nextElementSibling;
      const isExpanded = button.getAttribute('data-expanded') === 'true';
      
      if (isExpanded) {
        logContentDiv.style.display = 'none';
        button.textContent = '펼치기';
        button.setAttribute('data-expanded', 'false');
      } else {
        logContentDiv.style.display = 'block';
        button.textContent = '접기';
        button.setAttribute('data-expanded', 'true');
      }
    }
  </script>
</body>
</html>