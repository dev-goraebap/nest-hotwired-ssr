<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- 파라미터로 넘어온 title 데이터 사용 -->
  <% if (typeof title !== 'undefined') { %>
    <title><%= title %></title>
  <% } %>
  <!-- 파라미터로 description 데이터 사용  -->
  <% if (typeof description !== 'undefined') { %>
    <meta name="description" content="<%= description %>">
  <% } %>

  <!-- Tailwindcss -->
  <link rel="stylesheet" href="/public/css/tailwindcss@2.2.19.min.css"/>
  <link rel="stylesheet" href="/public/css/app.css"/>
  <link rel="stylesheet" href="/public/css/fonts.css"/>

  <!-- 
    hotwired/turbo 라이브러리
    
    Hotwired Turbo는 단일 페이지 앱(SPA)과 같은 사용자 경험을 제공하면서도
    서버 측 렌더링의 장점을 유지하는 JavaScript 라이브러리 입니다.
    
    주요 기능:
    - Turbo Drive: 페이지 이동 시 전체 페이지를 다시 로드하지 않고 AJAX로 컨텐츠를 가져와 DOM을 업데이트
    - Turbo Frames: 페이지 일부분만 독립적으로 업데이트 가능
    - Turbo Streams: 서버로부터 실시간 업데이트를 받아 DOM 요소 조작 (CRUD 작업)
  -->
  <script src="/public/js/turbo@8.0.13.min.js"></script>
  <script type="module" src="/public/js/controllers/index.js"></script>

  <!--
    페이지 필터링 시 애니메이션 제어 스크립트
    
    문제: 같은 페이지 내에서 필터링 등의 쿼리 파라미터 변경 시에도
    'page-animation-enter' 애니메이션이 매번 실행되어 불필요한 페이드 효과가 발생함
    
    해결: 같은 경로 내에서 쿼리 파라미터만 변경된 경우(필터링)에는
    애니메이션 클래스를 제거하여 부드러운 전환 경험을 제공
    
    효과: 페이지 첫 로드나 다른 페이지에서 이동할 때만 애니메이션 적용됨
  -->
  <script>
    document.addEventListener('turbo:before-render', function(event) {
      // 현재 URL과 새로운 URL의 경로가 같은지 확인 (쿼리 파라미터 제외)
      const currentPath = window.location.pathname;
      const newPath = new URL(event.detail.newBody.baseURI).pathname;
      
      if (currentPath === newPath) {
        // 같은 페이지 내에서의 필터링 변경인 경우, 애니메이션 클래스 제거
        const newBody = event.detail.newBody;
        const mainElement = newBody.querySelector('#main-content, main');
        if (mainElement) {
          mainElement.classList.remove('page-animation-enter');
        }
      }
    });
  </script>
</head>