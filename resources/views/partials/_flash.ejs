<% if (typeof error !== 'undefined' && error) { %>
  <div data-controller="flash-message" class="mt-4 p-4 border rounded-md flash-message error" role="alert">
    <div class="flex items-start justify-between">
      <div class="flex items-center">
        <!-- 오류 아이콘 -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-red-700"><%- error %></p>
      </div>
      <button type="button" data-action="flash-message#close" class="text-gray-500 hover:text-gray-800 focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
  <div data-controller="flash-message" class="mt-4 p-4 border rounded-md flash-message success" role="alert">
    <div class="flex items-start justify-between">
      <div class="flex items-center">
