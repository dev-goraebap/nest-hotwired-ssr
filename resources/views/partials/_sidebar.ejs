          <span>
            DR 공지 컨텐츠 관리
          </span>
        </a>
      </li>
      <!-- 매뉴 아이템 -->
      <li>
        <a href="/admin/versions" class="flex gap-2 justify-start items-center rounded-xl px-4 h-12
