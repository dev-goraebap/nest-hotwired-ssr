<%
  // 기본값 설정 (변수가 전달되지 않은 경우 기본값 사용)
  const currentPage = typeof activePage !== 'undefined' ? activePage : '';
%>

<!-- 사이드 바 -->
<aside class="w-64 border-r border-gray-300 h-full flex-shrink-0 bg-white flex flex-col">
  <!-- 헤더 영역 -->
  <div class="text-xl font-bold flex justify-center items-center py-6">
    <img src="/imgs/hero.png" alt="캡코플러그 로고" class="w-8 h-8 inline-block mr-2" data-turbo-permanent>
    <div>캡코플러그 관리</div>
  </div>
  
  <!-- 구분선 및 장식 요소 -->
  <div class="px-4 mb-4">
    <div class="h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
  </div>
  
  <!-- 메인 네비게이션 영역 -->
  <nav class="p-4 flex-grow overflow-y-auto">
    <ul class="flex flex-col gap-2 text-sm">
      <!-- 매뉴 아이템 -->
      <li>
        <a href="/admin/banners" class="flex gap-2 justify-start items-center rounded-xl px-4 h-12
        <%= currentPage === 'banners' ? 'bg-blue-900 text-white' : '' %>">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
