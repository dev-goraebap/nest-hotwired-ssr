<!-- 확인 모달 -->
<div
  data-action="keydown@window->confirm#keydown"
  class="hidden fixed inset-0 z-50 overflow-y-auto"
  data-confirm-target="container"
>
  <!-- 배경 오버레이 -->
  <div
    data-confirm-target="background"
    data-action="click->confirm#backgroundClick"
    class="fixed inset-0 bg-black opacity-0 transition-opacity duration-300 ease-in-out"
  ></div>

  <!-- 모달 내용 -->
  <div class="flex items-center justify-center min-h-screen p-4">
    <div
      data-confirm-target="content"
      class="bg-white rounded-lg shadow-xl w-full max-w-md p-6 transform -translate-y-8 opacity-0 transition-all duration-300 ease-in-out"
    >
      <div class="flex items-center justify-between mb-5">
        <h3
          class="text-lg font-medium text-gray-900"
          data-confirm-target="title"
        >
          확인
        </h3>
        <button
          type="button"
          data-action="confirm#close"
          class="text-gray-400 hover:text-gray-500"
        >
          <span class="sr-only">닫기</span>
          <svg
            class="h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>
      <div class="mt-3">
        <p class="text-sm text-gray-500" data-confirm-target="message">
          이 작업을 진행하시겠습니까? 이 작업은 취소할 수 없습니다.
        </p>
      </div>
      <div class="mt-5 flex justify-end gap-3">
        <button
          type="button"
          data-action="confirm#close"
          class="inline-flex justify-center px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-transparent rounded-md hover:bg-gray-200 focus:outline-none"
        >
          취소
        </button>
        <button
          type="button"
          data-action="confirm#confirm"
          class="inline-flex justify-center px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none"
          data-confirm-target="confirmButton"
        >
          확인
        </button>
      </div>
    </div>
  </div>
</div>
