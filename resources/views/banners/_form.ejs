<!-- Stimulus 컨트롤러 적용 -->
<div class="mt-6" data-controller="image-upload">
  <label for="image" class="block text-sm font-medium text-gray-700 mb-2">배너 이미지(1074x480) *</label>
  
  <div data-image-upload-target="dropArea" data-action="click->image-upload#browse dragenter->image-upload#highlight dragover->image-upload#highlight dragleave->image-upload#unhighlight drop->image-upload#handleDrop" class="border-2 border-dashed border-gray-300 rounded-lg p-6 flex flex-col items-center justify-center cursor-pointer hover:border-blue-500 transition-colors bg-white">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    <p class="text-gray-500 mb-2">이미지를 드래그하여 업로드하거나</p>
    <p class="text-blue-500 font-medium">파일 찾기</p>
    <div data-image-upload-target="preview" class="mt-4 w-full <%= (formData && formData.imageUrl) ? '' : 'hidden' %>">
      <img data-image-upload-target="imagePreview" src="<%= (formData && formData.imageUrl) ? formData.imageUrl : '' %>" class="max-h-40 mx-auto rounded" />
    </div>
  </div>
  
  <input type="file" data-image-upload-target="fileInput" data-action="change->image-upload#preview" id="image" name="image" accept="image/*" class="absolute opacity-0" style="width:1px; height:1px; overflow:hidden;" />

  <% if (isEdit && formData && formData.imageUrl) { %>
    <p class="mt-2 text-sm text-gray-500">새 이미지를 선택하지 않으면 기존 이미지가 유지됩니다.</p>
  <% } %>
</div>

<!-- 액션 타입 선택 -->
<div class="mt-4">
  <label for="actionType" class="block text-sm font-medium text-gray-700">액션 타입 *</label>
  <select id="actionType" name="actionType" class="mt-1 p-4 border rounded-lg w-full">
    <option value="" disabled <%= (!formData || !formData.actionType) ? 'selected' : '' %>>액션 타입을 선택하세요</option>
    <option value="LINK" <%= (formData && formData.actionType === 'LINK') ? 'selected' : '' %>>외부링크</option>
    <option value="DR" <%= (formData && formData.actionType === 'DR') ? 'selected' : '' %>>국민DR</option>
    <option value="PLUS_DR" <%= (formData && formData.actionType === 'PLUS_DR') ? 'selected' : '' %>>플러스DR</option>
    <option value="GUIDE" <%= (formData && formData.actionType === 'GUIDE') ? 'selected' : '' %>>가이드</option>
  </select>
</div>

<!-- 액션 URL (링크형 배너의 경우) -->
<div id="actionUrlContainer" class="mt-4">
  <label for="actionUrl" class="block text-sm font-medium text-gray-700">액션 URL (링크형 배너의 경우 필수)</label>
  <input type="url" id="actionUrl" name="actionUrl" class="mt-1 p-4 border rounded-lg w-full" 
         placeholder="https://example.com" 
         value="<%= (formData && formData.actionUrl) ? formData.actionUrl : '' %>" />
</div>

<!-- 표시 순서 필드 제거 -->

<!-- 버튼 영역 -->
<div class="mt-6 flex justify-between">
  <a href="/admin/banners" class="flex items-center justify-center gap-2 h-12 px-4 bg-gray-300 text-gray-700 rounded-xl" style="width: 100px;">
    <span class="text-sm">취소</span>
  </a>
  
  <button type="submit" class="flex items-center justify-center gap-2 h-12 px-4 bg-blue-900 text-white rounded-xl" style="width: 200px;">
    <span class="text-sm"><%= isEdit ? '배너 이미지 수정' : '배너 이미지 등록' %></span>
  </button>
</div>

<script>
  function updateUrlField() {
    const actionTypeSelect = document.getElementById('actionType');
    const actionUrlContainer = document.getElementById('actionUrlContainer');
    
    if (!actionTypeSelect || !actionUrlContainer) return;
    
    if (actionTypeSelect.value === 'LINK') {
      actionUrlContainer.style.display = 'block';
    } else {
      actionUrlContainer.style.display = 'none';
    }
  }
  
  // DOM이 로드될 때 및 Turbo 페이지 전환 시 URL 필드 업데이트
  document.addEventListener('DOMContentLoaded', updateUrlField);
  document.addEventListener('turbo:load', updateUrlField);
  
  // 액션 타입 변경 이벤트 리스너
  document.addEventListener('DOMContentLoaded', function() {
    const actionTypeSelect = document.getElementById('actionType');
    if (actionTypeSelect) {
      actionTypeSelect.addEventListener('change', updateUrlField);
    }
  });
  
  document.addEventListener('turbo:load', function() {
    const actionTypeSelect = document.getElementById('actionType');
    if (actionTypeSelect) {
      actionTypeSelect.addEventListener('change', updateUrlField);
    }
  });
</script>