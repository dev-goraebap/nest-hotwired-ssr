<!DOCTYPE html>
<html lang="ko">
<%- include('../partials/_head.ejs', { 
  title: '배너 이미지 등록',
  description: `
  - 배너 이미지를 등록합니다.
  `,
}) %>
<body>
  <div class="flex h-screen">
    <%- include('../partials/_sidebar.ejs', { activePage: 'banners' }) %>
    <main class="w-full h-full p-10 page-animation-enter" style="min-width: 800px; width: 800px;">
      <h1 class="text-3xl font-bold text-gray-800">
        배너 이미지 등록
      </h1>

      <!-- 플래시 메시지 파셜 포함 -->
      <%- include('../partials/_flash.ejs') %>

      <!-- 배너 등록 폼 -->
      <form action="/admin/banners" method="POST" enctype="multipart/form-data" id="bannerForm">
        <!-- 공통 폼 파셜 포함 -->
        <%- include('./_form.ejs', { formData, isEdit: false }) %>
      </form>
    </main>
  </div>
</body>
</html>