<!DOCTYPE html>
<html lang="ko">
<%- include('../partials/_head.ejs', { 
  title: '배너 이미지 등록',
  description: `
  - 배너 이미지를 등록합니다.
  `,
}) %>
<body>
  <div class="flex h-screen">
    <%- include('../partials/_sidebar.ejs', { activePage: 'banners' }) %>
    <main class="w-full h-full p-10" style="min-width: 800px; width: 800px;">
      <h1 class="text-3xl font-bold text-gray-800">
        배너 이미지 등록
      </h1>

      <!-- 오류 메시지 표시 영역 -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mt-4 p-4 bg-red-50 border border-red-300 rounded-md error-message">
          <p class="text-red-700"><%- error %></p>
        </div>
      <% } %>

      <!-- 배너 등록 폼 -->
      <form action="/admin/banners" method="POST" enctype="multipart/form-data" id="bannerForm">
        <div class="mt-6">
          <label for="image" class="block text-sm font-medium text-gray-700 mb-2">배너 이미지(1074x480) *</label>
          <div id="drop-area" class="border-2 border-dashed border-gray-300 rounded-lg p-6 flex flex-col items-center justify-center cursor-pointer hover:border-blue-500 transition-colors bg-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-gray-500 mb-2">이미지를 드래그하여 업로드하거나</p>
            <p class="text-blue-500 font-medium">파일 찾기</p>
            <div id="preview" class="mt-4 w-full hidden">
              <img id="image-preview" class="max-h-40 mx-auto rounded" />
            </div>
          </div>
          <input type="file" id="image" name="image" accept="image/*" class="absolute opacity-0" style="width:1px; height:1px; overflow:hidden;" />
        </div>

        <div class="mt-4">
          <label for="actionType" class="block text-sm font-medium text-gray-700">액션 타입 *</label>
          <select id="actionType" name="actionType" class="mt-1 p-4 border rounded-lg w-full">
            <option value="" disabled <%= typeof formData === 'undefined' || !formData.actionType ? 'selected' : '' %>>액션 타입을 선택하세요</option>
            <option value="LINK" <%= typeof formData !== 'undefined' && formData.actionType === 'LINK' ? 'selected' : '' %>>외부링크</option>
            <option value="DR" <%= typeof formData !== 'undefined' && formData.actionType === 'DR' ? 'selected' : '' %>>국민DR</option>
            <option value="PLUS_DR" <%= typeof formData !== 'undefined' && formData.actionType === 'PLUS_DR' ? 'selected' : '' %>>플러스DR</option>
            <option value="GUIDE" <%= typeof formData !== 'undefined' && formData.actionType === 'GUIDE' ? 'selected' : '' %>>가이드</option>
          </select>
        </div>

        <div id="actionUrlContainer" class="mt-4">
          <label for="actionUrl" class="block text-sm font-medium text-gray-700">액션 URL (링크형 배너의 경우 필수)</label>
          <input type="url" id="actionUrl" name="actionUrl" class="mt-1 p-4 border rounded-lg w-full" 
                 placeholder="https://example.com" 
                 value="<%= typeof formData !== 'undefined' && formData.actionUrl ? formData.actionUrl : '' %>" />
        </div>

        <div class="mt-6 flex justify-between">
          <a href="/admin/banners" class="flex items-center justify-center gap-2 h-12 px-4 bg-gray-300 text-gray-700 rounded-xl" style="width: 100px;">
            <span class="text-sm">취소</span>
          </a>
          
          <button type="submit" class="flex items-center justify-center gap-2 h-12 px-4 bg-blue-900 text-white rounded-xl" style="width: 200px;">
            <span class="text-sm">배너 이미지 등록</span>
          </button>
        </div>
      </form>
    </main>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const dropArea = document.getElementById('drop-area');
      const fileInput = document.getElementById('image');
      const preview = document.getElementById('preview');
      const imagePreview = document.getElementById('image-preview');
      const actionTypeSelect = document.getElementById('actionType');
      const actionUrlContainer = document.getElementById('actionUrlContainer');
      
      // 액션 타입이 변경될 때 URL 필드 표시 여부 결정
      actionTypeSelect.addEventListener('change', function() {
        if (this.value === 'LINK') {
          actionUrlContainer.style.display = 'block';
        } else {
          actionUrlContainer.style.display = 'none';
        }
      });
      
      // 초기 로드 시 액션 타입에 따라 URL 필드 표시 여부 설정
      if (actionTypeSelect.value === 'LINK') {
        actionUrlContainer.style.display = 'block';
      } else {
        actionUrlContainer.style.display = 'none';
      }
      
      // 드롭 영역 클릭 시 파일 선택 다이얼로그 열기
      dropArea.addEventListener('click', () => fileInput.click());
      
      // 파일 선택 시 미리보기 표시
      fileInput.addEventListener('change', function() {
        if (this.files && this.files[0]) {
          const reader = new FileReader();
          
          reader.onload = function(e) {
            imagePreview.src = e.target.result;
            preview.classList.remove('hidden');
            dropArea.classList.add('border-blue-500');
          };
          
          reader.readAsDataURL(this.files[0]);
        }
      });
      
      // 드래그 앤 드롭 이벤트
      ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, preventDefaults, false);
      });
      
      function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
      }
      
      // 드래그 효과
      ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => {
          dropArea.classList.add('border-blue-500', 'bg-blue-50');
        });
      });
      
      ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => {
          dropArea.classList.remove('bg-blue-50');
          if (!fileInput.files || !fileInput.files[0]) {
            dropArea.classList.remove('border-blue-500');
          }
        });
      });
      
      // 파일 드롭
      dropArea.addEventListener('drop', function(e) {
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
          fileInput.files = e.dataTransfer.files;
          
          const reader = new FileReader();
          reader.onload = function(e) {
            imagePreview.src = e.target.result;
            preview.classList.remove('hidden');
            dropArea.classList.add('border-blue-500');
          };
          
          reader.readAsDataURL(e.dataTransfer.files[0]);
        }
      });
    });
  </script>
</body>
</html>