<!DOCTYPE html>
<html lang="ko">
<%- include('../partials/_head.ejs', { 
  title: '다이나믹 컨텐츠 관리 - 수정',
  description: `
  `,
}) %>
<body>
  <div class="flex h-screen">
    <!-- 사이드바 -->
    <%- include('../partials/_sidebar.ejs', { activePage: 'dr-notices' }) %>

    <!-- 메인컨텐츠 -->
    <main class="w-full h-full p-10 page-animation-enter overflow-y-auto">
      <div style="min-width: 1300px; max-width: 1300px;">
        <div class="flex justify-between items-center">
          <h1 class="text-3xl font-bold text-gray-800">
            다이나믹 컨텐츠 수정
          </h1>
        </div>
        
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="mt-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-md">
            <%- error %>
          </div>
        <% } %>
      
        <!-- 폼 컨텐츠 -->
        <form class="mt-8" id="dynamicContentForm" method="POST" action="/admin/dynamic-content/update/<%= contentId %>">
          <%- include('./_form.ejs', { formData, isEdit: true }) %>
        </form>
      </div>
    </main>
  </div>
</body>
</html>